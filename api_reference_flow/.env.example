# Copy to .env (do not commit .env) and fill in real values.
# All modules read configuration from environment variables only.

# Snyk API token with access to the org(s) below. See:
# https://docs.snyk.io/snyk-api/authentication-for-api
SNYK_TOKEN=

# Snyk organization ID that owns both the main and feature branch projects.
SNYK_ORG_ID=

# Path to the local checkout used by steps 1 and 3 when shelling out to the
# Snyk CLI. Use a feature-branch checkout for step 1 and a main-branch checkout
# for step 3.
PROJECT_DIRECTORY=

# Feature branch project name passed to `snyk monitor` (step 1), for example
# my-repo:feature/my-branch
SNYK_PROJECT_NAME=

# Main branch project name passed to `snyk monitor` (step 3), for example
# my-repo:main
MAIN_SNYK_PROJECT_NAME=

# Snyk project ID for the feature branch target reference (step 2 reads
# ignores from here; step 1 monitors this branch).
FEATURE_PROJECT_ID=

# Snyk project ID for the "main" target reference (step 2 writes ignores
# here; step 3 monitors this branch).
MAIN_PROJECT_ID=

# Repository remote URL used to look up an existing SCM target (step 5) and
# to import the repo (step 6), for example https://github.com/org/repo
REPO_URL=

# Snyk integration ID for the SCM integration to import through (step 6),
# for example the GitHub Enterprise or GitHub Cloud App integration ID.
SNYK_INTEGRATION_ID=

# Branch to import for SCM (SAST) scanning (step 6). Defaults to main if
# unset.
SCM_BRANCH=main
